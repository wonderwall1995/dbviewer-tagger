{
  "name": "dbviewer-tagger",
  "version": "0.1.0",
  "description": "Context Enrichment Docs authoring tool",
  "main": "apps/desktop/dist/main.js",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:vite\" \"pnpm run dev:electron\"",
    "dev:vite": "pnpm --filter @tagger/ui dev",
    "dev:electron": "wait-on tcp:6200 && pnpm run build:electron && node scripts/dev-electron.js",
    "build": "pnpm run build:vite && pnpm run build:electron",
    "build:vite": "pnpm --filter @tagger/ui build",
    "build:electron": "pnpm --filter @tagger/desktop... run build",
    "dist": "pnpm run build && electron-builder",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "typecheck": "pnpm --filter @tagger/ui typecheck",
    "test": "pnpm run build:electron && pnpm run build:server && pnpm --filter @tagger/server run bundle && node --test scripts/*.test.cjs",
    "build:server": "pnpm --filter @tagger/server... run build",
    "start:server": "node apps/server/dist/index.js",
    "dev:web": "pnpm run build:server && concurrently \"node apps/server/dist/index.js\" \"pnpm --filter @tagger/ui dev\"",
    "build:web": "pnpm run build:vite && pnpm run build:server",
    "build:core": "pnpm --filter @tagger/core build",
    "web:admin": "node apps/server/dist/admin.js",
    "bundle:server": "pnpm run build:core && pnpm --filter @tagger/server run bundle"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "wait-on": "^7.0.0",
    "@tagger/ui": "workspace:*"
  },
  "dependencies": {
    "@types/papaparse": "^5.3.14",
    "papaparse": "^5.4.1",
    "pg": "^8.22.0",
    "ssh2": "^1.17.0",
    "@tagger/core": "workspace:*",
    "@tagger/desktop": "workspace:*"
  },
  "build": {
    "appId": "io.github.wonderwall1995.dbviewer-tagger",
    "productName": "DBViewer-tagger",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "packages/core/dist/**/*",
      "packages/core/package.json",
      "packages/ui/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "FONT-LICENSES.md",
        "to": "FONT-LICENSES.md"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
