# /etc/tagger/tagger.env (setup-server.sh 가 이 파일을 복사한다). 비밀 값은 없다.
# 입장 코드는 이 파일이 아니라 데이터 폴더에 해시로 저장된다 (tagger-admin.sh set-code).
NODE_ENV=production
TAGGER_SOCKET=/run/tagger/tagger.sock
TAGGER_DATA_DIR=/var/lib/tagger
TAGGER_SAMPLE_DIR=/var/lib/tagger/sample
TAGGER_MAX_SESSIONS=10
TAGGER_SESSION_MB=200
TAGGER_SESSION_IDLE_HOURS=24
TAGGER_UPLOAD_MB=20
