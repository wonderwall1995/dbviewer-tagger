{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist/server",
    "rootDir": "src",
    "resolveJsonModule": true
  },
  "include": ["src/server", "src/main/core", "src/main/cedIndex.ts", "src/main/workspaceBackup.ts"]
}
